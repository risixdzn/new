---
import Layout from '@/layouts/Layout.astro'
import { Greeting } from '@/components/greeting'
import { GoogleSearch } from '@/components/google-search'
import { QuickLinks } from '@/components/quick-links'
import { ThemeToggle } from '@/components/theme-toggle'
import { TodoList } from '@/components/todo-list'
import { Snippets } from '@/components/snippets'
---

<Layout>
  <main class="min-h-screen w-full px-6 py-16">
    <ThemeToggle client:load />
    <div class="mx-auto flex w-full max-w-xl flex-col gap-12">
      <Greeting client:load />

      <div class="flex flex-col gap-6">
        <GoogleSearch client:load />
        <QuickLinks client:load />
      </div>

      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
        <TodoList client:load />
        <Snippets client:load />
      </div>
    </div>
  </main>
</Layout>
