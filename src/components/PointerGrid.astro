---
// The FlickeringGrid, following you: a full-screen field of 4px squares on a
// 10px pitch (same rhythm as the contact section's grid) that wakes up along
// the pointer's path, sized by how fast you move, with a ring on every click.
// Inspired by naved.xyz's cursor cells.
//
// Raw WebGL, no deps. The GL context is created on first interaction and the
// render loop sleeps whenever the field has decayed to nothing.
//
// Perf notes:
// - Rendered at 1x and upscaled with `image-rendering: pixelated`. The squares
//   are whole CSS pixels, so it looks identical at a quarter of the fill cost on
//   retina screens.
// - "Am I over text?" hit-testing happens in the pointer handler (throttled),
//   never per frame.
---

<canvas
    data-pointer-grid
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-0 size-full [image-rendering:pixelated]"></canvas>

<script is:inline>
    (() => {
        const canvas = document.querySelector("[data-pointer-grid]");
        if (!canvas || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const VERT = `
            attribute vec2 aPos;
            void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
        `;
        const FRAG = `
            precision highp float;
            uniform vec2 uRes;        // viewport, CSS px
            uniform float uTime;
            uniform vec3 uInk;        // foreground colour, 0..1
            uniform vec3 uTrail[6];   // x, y (CSS px, y down), strength
            uniform vec3 uRipple[3];  // x, y, age in seconds; age < 0 = unused

            const float PITCH = 10.0;
            const float LIFE = 0.9;

            float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
            float blob(vec2 p, vec2 c, float r, float k) { vec2 d = p - c; return k * exp(-dot(d, d) / (r * r)); }

            void main() {
                vec2 px = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y);
                vec2 cell = floor(px / PITCH);
                vec2 c = (cell + 0.5) * PITCH;

                float trail = 0.0;
                for (int i = 0; i < 6; i++) trail += blob(c, uTrail[i].xy, 46.0 - float(i) * 4.0, uTrail[i].z);
                // Per-cell flicker on the trail only, re-rolled ~8x a second like the FlickeringGrid.
                trail *= 0.6 + 0.4 * hash(cell + floor(uTime * 8.0));

                // Branch-free on purpose: some GLSL ES 1.0 compilers (ANGLE/SwiftShader)
                // mishandle \`continue\` inside loops over uniform arrays.
                float ring = 0.0;
                for (int j = 0; j < 3; j++) {
                    vec3 rp = uRipple[j];
                    float age = max(rp.z, 0.0);
                    float live = step(0.0, rp.z) * step(age, LIFE);
                    float k = age / LIFE;
                    float ease = 1.0 - (1.0 - k) * (1.0 - k) * (1.0 - k); // easeOutCubic
                    float d = length(c - rp.xy) - (10.0 + 320.0 * ease);
                    ring += live * (1.0 - k) * exp(-(d * d) / 520.0);
                }
                // Stable per-cell texture so the ring reads as one smooth wave.
                ring *= 0.8 + 0.2 * hash(cell);

                float v = trail + ring;
                float size = 0.0; float a = 0.0;
                if (v >= 0.72)      { size = 4.0; a = 0.55; }
                else if (v >= 0.5)  { size = 3.0; a = 0.42; }
                else if (v >= 0.32) { size = 2.0; a = 0.32; }
                else if (v >= 0.16) { size = 1.0; a = 0.24; }

                vec2 f = abs(px - c);
                float inside = step(f.x, size * 0.5) * step(f.y, size * 0.5) * step(0.5, size);
                float alpha = inside * a;
                gl_FragColor = vec4(uInk * alpha, alpha); // premultiplied
            }
        `;

        let gl = null, u = {}, raf = 0, failed = false;
        const t0 = performance.now();
        const now = () => (performance.now() - t0) / 1000;

        const target = { x: 0, y: 0 }, pos = { x: 0, y: 0 };
        let seen = false, energy = 0, legible = 1, overText = false, lastProbe = 0, lastFrame = 0;
        const history = [], ripples = [];
        const LIFE = 0.9;

        const TEXTY = "p, h1, h2, h3, h4, h5, h6, li, dt, dd, a, button, label, summary, figcaption, blockquote, time, input, textarea, [data-no-grid]";
        const PROBES = [[0, 0], [-14, 0], [14, 0], [0, -10], [0, 10]];

        const ink = () => {
            const m = getComputedStyle(document.body).color.match(/\d+(\.\d+)?/g) || [0, 0, 0];
            return [m[0] / 255, m[1] / 255, m[2] / 255];
        };

        function init() {
            if (gl || failed) return !!gl;
            gl = canvas.getContext("webgl", { alpha: true, premultipliedAlpha: true, antialias: false, depth: false, stencil: false });
            if (!gl) return !(failed = true);
            const sh = (type, src) => {
                const s = gl.createShader(type);
                gl.shaderSource(s, src);
                gl.compileShader(s);
                return s;
            };
            const prog = gl.createProgram();
            gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
            gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
            gl.linkProgram(prog);
            if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
                gl = null;
                return !(failed = true);
            }
            gl.useProgram(prog);
            gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(prog, "aPos");
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
            for (const n of ["uRes", "uTime", "uInk", "uTrail", "uRipple"]) u[n] = gl.getUniformLocation(prog, n);
            gl.enable(gl.BLEND);
            gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
            gl.clearColor(0, 0, 0, 0);
            resize();
            gl.uniform3fv(u.uInk, ink());
            return true;
        }

        function resize() {
            if (!gl) return;
            canvas.width = innerWidth;
            canvas.height = innerHeight;
            gl.viewport(0, 0, innerWidth, innerHeight);
            gl.uniform2f(u.uRes, innerWidth, innerHeight);
        }

        // Quiet the trail over text so the grid never fights with reading.
        function probe(x, y, ts) {
            if (ts - lastProbe < 80) return;
            lastProbe = ts;
            overText = PROBES.some(([dx, dy]) => document.elementFromPoint(x + dx, y + dy)?.closest(TEXTY));
        }

        const trail = new Float32Array(18);
        const rip = new Float32Array(9);

        function frame(ts) {
            raf = 0;
            const dt = (lastFrame ? Math.min(ts - lastFrame, 50) : 16.7) / 16.7;
            lastFrame = ts;

            // Smoothly chase the pointer and remember where we've been.
            const k = 1 - Math.pow(0.65, dt);
            pos.x += (target.x - pos.x) * k;
            pos.y += (target.y - pos.y) * k;
            history.unshift({ x: pos.x, y: pos.y, t: ts });
            while (history.length > 1 && ts - history[history.length - 1].t > 320) history.pop();

            energy *= Math.pow(0.93, dt);
            legible += ((overText ? 0.15 : 1) - legible) * (1 - Math.pow(0.7, dt));

            for (let i = 0, h = 0; i < 6; i++) {
                while (h < history.length - 1 && ts - history[h].t < 50 * i) h++;
                const p = history[h] || pos;
                trail[i * 3] = p.x;
                trail[i * 3 + 1] = p.y;
                trail[i * 3 + 2] = energy * legible * (1 - i / 6) * 0.95;
            }

            // Ripple ages are computed here in JS, so the shader never sees large time values.
            const t = now();
            for (let i = ripples.length - 1; i >= 0; i--) if (t - ripples[i][2] > LIFE) ripples.splice(i, 1);
            for (let i = 0; i < 3; i++) {
                const r = ripples[i];
                rip[i * 3] = r ? r[0] : 0;
                rip[i * 3 + 1] = r ? r[1] : 0;
                rip[i * 3 + 2] = r ? t - r[2] : -1;
            }

            gl.clear(gl.COLOR_BUFFER_BIT);
            gl.uniform1f(u.uTime, t % 1000);
            gl.uniform3fv(u.uTrail, trail);
            gl.uniform3fv(u.uRipple, rip);
            gl.drawArrays(gl.TRIANGLES, 0, 3);

            if (energy > 0.01 || ripples.length) raf = requestAnimationFrame(frame);
            else lastFrame = 0;
        }

        const wake = () => {
            if (init() && !raf) raf = requestAnimationFrame(frame);
        };

        addEventListener(
            "pointermove",
            (e) => {
                if (e.pointerType !== "mouse") return;
                if (!seen) {
                    pos.x = target.x = e.clientX;
                    pos.y = target.y = e.clientY;
                    seen = true;
                }
                const dist = Math.hypot(e.clientX - target.x, e.clientY - target.y);
                target.x = e.clientX;
                target.y = e.clientY;
                energy = Math.min(1, energy + dist / 140);
                probe(e.clientX, e.clientY, e.timeStamp);
                wake();
            },
            { passive: true },
        );

        addEventListener(
            "pointerdown",
            (e) => {
                ripples.unshift([e.clientX, e.clientY, now()]);
                ripples.length = Math.min(ripples.length, 3);
                wake();
            },
            { passive: true },
        );

        addEventListener("resize", () => {
            resize();
            wake();
        });

        // Theme toggles flip the ink colour.
        addEventListener("themeChange", () => gl && gl.uniform3fv(u.uInk, ink()));
    })();
</script>
