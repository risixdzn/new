{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static pages are served as assets; only /api/* runs the worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
