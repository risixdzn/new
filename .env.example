# GitHub OAuth App (github.com/settings/developers > OAuth Apps > New OAuth App)
# Authorization callback URL: <your origin>/api/auth/callback
# GitHub allows one callback URL per app, so use a separate app for local dev
# (callback http://localhost:4321/api/auth/callback).
# In production, set both as Worker secrets:
#   npx wrangler secret put GITHUB_CLIENT_ID
#   npx wrangler secret put GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
